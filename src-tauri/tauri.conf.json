{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipCork",
  "version": "0.1.2",
  "identifier": "com.beecork.clipcork",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipCork",
        "width": 360,
        "height": 520,
        "minWidth": 320,
        "minHeight": 300,
        "maxWidth": 500,
        "maxHeight": 700,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Beecork",
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/beecork/clipcork/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RTEwRUYwODUyQkNEM0MKUldROHpTdUY4QTdoUklPMnIyNEpnOTk0cEJvTnU3bHFSZStkOE12SGh5OWlPRHFzMkY4N2RDTTgK"
    }
  }
}
